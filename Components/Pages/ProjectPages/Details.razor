@page "/projects/details"
@rendermode InteractiveServer

@using DeploymentManagementSystem.Data
@using DeploymentManagementSystem.Extensions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using DeploymentManagementSystem.Data.Models

@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Проект</PageTitle>

<h1>Проект</h1>

<div>
    @if (project is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <h2>@project.Name</h2>
        @if (project.Description is not null)
        {
            <p style="width: 600px; text-align: justify;">@project.Description</p>
        }
        @if (project.GitlabUrl is not null)
        {
            <a target="_blank" rel="noopener noreferrer" href="@project.GitlabUrl">
                <img src="icons/gitlab.svg" alt="GitLab" style="width: 32px; height: 32px; vertical-align: middle;" />
            </a>
            if (project.IsGitlabConnected)
            {
                <img src="icons/green-check.svg" alt="Подключено" title="Подключено" style="width: 24px; height: 24px; vertical-align: middle; margin-left: 8px;" />
            } else
            {
                <img src="icons/red-x.svg" alt="Нет подключения" title="Нет подключения" style="width: 24px; height: 24px; vertical-align: middle; margin-left: 8px;" />
            }
        }
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Дата начала</dt>
            <dd class="col-sm-10">@project.StartDate.ToShortDateString()</dd>
            @if (project.EndDate is not null)
            {
                <dt class="col-sm-2">Дата окончания</dt>
                <dd class="col-sm-10">@project.EndDate.Value.ToShortDateString()</dd>
            }
            <dt class="col-sm-2">Руководитель проекта</dt>
            <dd class="col-sm-10">@project.ProjectManager!.Fullname</dd>
        </dl>
        <AuthorizeView Roles="Admin,ProjectManager">
            <div>
                <a href="@($"/projects/edit?id={project.Id}")">Редактировать</a> |
                <a href="@($"/projects")">Назад к списку</a>
            </div>
        </AuthorizeView>

        <a href=@($"tasks?projectid={project!.Id}")>Задачи проекта</a>
    }
</div>

<h3 class="mt-lg-3">Участники</h3>

@if (Participants == null)
{
    <p>Загрузка...</p>
}
else if (Participants.Count == 0)
{
    <p>Участники не найдены.</p>
}
else
{
    <table border="1">
        <thead>
            <tr>
                <th>Электронная почта</th>
                <th>Фамилия</th>
                <th>Имя</th>
                <th>Отчество</th>
                <th>Роль</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Participants)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@user.Lastname</td>
                    <td>@user.Name</td>
                    <td>@user.Patronymic</td>
                    <td>@user.GetRoleTranslation()</td>
                    <td>
                        <AuthorizeView Roles="Admin,ProjectManager">
                            @if (user.Id == currentUserId)
                            {
                                <button class="btn btn-danger" @onclick="() => OnExcludeFromProjectButtonClick(user)" disabled>Исключить из проекта</button>
                            }
                            else
                            {
                                <button class="btn btn-danger" @onclick="() => OnExcludeFromProjectButtonClick(user)">Исключить из проекта</button>
                            }
                        </AuthorizeView>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <AuthorizeView Roles="Admin,ProjectManager">
        <a href=@($"/AddUserToProject?id={project!.Id}") class="btn btn-primary mt-4">Добавить пользователей в проект</a>
    </AuthorizeView>
}

@code {
    private Project? project;
    private List<ApplicationUser> Participants = new();
    private string? currentUserId;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        project = await context.Projects
                                    .Include(p => p.ProjectManager)
                                    .Include(p => p.Participants)
                                    .FirstOrDefaultAsync(m => m.Id == Id);

        if (project is null)
        {
            NavigationManager.NavigateTo("notfound");
        }

        Participants
            .AddRange(project!.Participants!
                        .OrderByDescending(u => u.Role)
                        .ThenBy(u => u.Lastname)
                        .ThenBy(u => u.Name)
                        .ThenBy(u => u.Patronymic));


        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        }
    }

    private void OnExcludeFromProjectButtonClick(ApplicationUser user)
    {
        using var context = DbFactory.CreateDbContext();
        var participants = context!.Projects.Include(p => p.Participants).FirstOrDefault(p => p.Id == project!.Id)!.Participants!;
        ApplicationUser userToRemove = participants.FirstOrDefault(p => p.Id == user.Id)!;
        context!.Projects.Include(p => p.Participants).FirstOrDefault(p => p.Id == project!.Id)!.Participants!.Remove(userToRemove);
        context.SaveChanges();
        Participants.Remove(user);
        StateHasChanged();
    }
}
