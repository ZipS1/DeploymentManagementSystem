@page "/projects/details"
@rendermode InteractiveServer

@using DeploymentManagementSystem.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using DeploymentManagementSystem.Data.Models

@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Project</PageTitle>

<h1>Project</h1>

<div>
    @if (project is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <h2>@project.Name</h2>
        @if (project.Description is not null)
        {
            <p>@project.Description</p>
        }
        @if (project.GitlabUrl is not null)
        {
            <a target="_blank" rel="noopener noreferrer" href="@project.GitlabUrl">GitLab</a>
        }
        <hr />
        <dl class="row">
            <dt class="col-sm-2">StartDate</dt>
            <dd class="col-sm-10">@project.StartDate.ToShortDateString()</dd>
            @if (project.EndDate is not null)
            {
                <dt class="col-sm-2">EndDate</dt>
                <dd class="col-sm-10">@project.EndDate.Value.ToShortDateString()</dd>
            }
            <dt class="col-sm-2">ProjectManager</dt>
            <dd class="col-sm-10">@project.ProjectManager!.Fullname</dd>
        </dl>
        <AuthorizeView Roles="Admin,ProjectManager">
            <div>
                <a href="@($"/projects/edit?id={project.Id}")">Edit</a> |
                <a href="@($"/projects")">Back to List</a>
            </div>
        </AuthorizeView>
    }
</div>

<h3 class="mt-lg-3">Participants</h3>

@if (Participants == null)
{
    <p>Loading...</p>
}
else if (Participants.Count == 0)
{
    <p>No participants found.</p>
}
else
{
    <table border="1">
        <thead>
            <tr>
                <th>Email</th>
                <th>Lastname</th>
                <th>Name</th>
                <th>Patronymic</th>
                <th>Role</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Participants)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@user.Lastname</td>
                    <td>@user.Name</td>
                    <td>@user.Patronymic</td>
                    <td>@user.Role</td>
                    <td>
                        <AuthorizeView Roles="Admin,ProjectManager">
                            @if (user.Id == currentUserId)
                            {
                                <button class="btn btn-danger" @onclick="() => OnExcludeFromProjectButtonClick(user)" disabled>Exclude from project</button>
                            }
                            else
                            {
                                <button class="btn btn-danger" @onclick="() => OnExcludeFromProjectButtonClick(user)">Exclude from project</button>
                            }
                        </AuthorizeView>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <AuthorizeView Roles="Admin,ProjectManager">
        <a href=@($"/AddUserToProject?id={project!.Id}") class="btn btn-primary mt-4">Add users to project</a>
    </AuthorizeView>
}

@code {
    private Project? project;
    private List<ApplicationUser> Participants = new();
    private string? currentUserId;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        project = await context.Projects
                                    .Include(p => p.ProjectManager)
                                    .Include(p => p.Participants)
                                    .FirstOrDefaultAsync(m => m.Id == Id);

        if (project is null)
        {
            NavigationManager.NavigateTo("notfound");
        }

        Participants.AddRange(project!.Participants!);

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        }
    }

    private void OnExcludeFromProjectButtonClick(ApplicationUser user)
    {
        using var context = DbFactory.CreateDbContext();
        var participants = context!.Projects.Include(p => p.Participants).FirstOrDefault(p => p.Id == project!.Id)!.Participants!;
        ApplicationUser userToRemove = participants.FirstOrDefault(p => p.Id == user.Id)!;
        context!.Projects.Include(p => p.Participants).FirstOrDefault(p => p.Id == project!.Id)!.Participants!.Remove(userToRemove);
        context.SaveChanges();
        Participants.Remove(user);
        StateHasChanged();
    }
}
