@page "/projects"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using DeploymentManagementSystem.Data.Models
@using DeploymentManagementSystem.Data

@attribute [Authorize(Roles = "Admin,ProjectManager")]
@implements IAsyncDisposable
@inject IDbContextFactory<DeploymentManagementSystem.Data.ApplicationDbContext> DbFactory

<PageTitle>Все проекты</PageTitle>

<h1>Все проекты</h1>

<p>
    <a href="projects/create">Создать новый</a>
</p>

<QuickGrid Class="table" Items="context.Projects.Include(p => p.ProjectManager)">
    <TemplateColumn Context="project" Title="Название">
        <a href="@($"projects/details?id={project.Id}")">@project.Name</a>
    </TemplateColumn>
    <TemplateColumn Context="project" Title="Описание">
        @(!string.IsNullOrEmpty(project.Description)
            ? project.Description
            : "-")
    </TemplateColumn>
    <TemplateColumn Context="project" Title="Дата начала">
        @project.StartDate.ToShortDateString()
    </TemplateColumn>
    <TemplateColumn Context="project" Title="Дата окончания">
        @(project.EndDate is not null
            ? project.EndDate.Value.ToShortDateString()
            : "-")
    </TemplateColumn>
    <TemplateColumn Context="project" Title="URL GitLab">
        @(!string.IsNullOrEmpty(project.GitlabUrl)
            ? project.GitlabUrl
            : "-")
    </TemplateColumn>
    <TemplateColumn Context="project" Title="Руководитель проекта">
        @project.ProjectManager?.Fullname
    </TemplateColumn>

    <TemplateColumn Context="project">
        <a href="@($"projects/edit?id={project.Id}")">Редактировать</a> |
        <a href="@($"projects/details?id={project.Id}")">Детали</a> |
        <a href="@($"projects/delete?id={project.Id}")">Удалить</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private ApplicationDbContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
