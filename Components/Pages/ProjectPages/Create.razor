@page "/projects/create"

@using DeploymentManagementSystem.Components.Account
@using DeploymentManagementSystem.Data
@using DeploymentManagementSystem.Data.DomainStringConstants
@using DeploymentManagementSystem.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using DeploymentManagementSystem.Data.Models

@attribute [Authorize(Roles = "Admin,ProjectManager")]
@inject IDbContextFactory<DeploymentManagementSystem.Data.ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager

@inject GitlabService GitlabService
@rendermode InteractiveServer

<PageTitle>Создать</PageTitle>

<h1>Создать</h1>

<h2>Проект</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Project" OnValidSubmit="AddProject" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="mb-3">
                <label for="name" class="form-label">Название*:</label>
                <InputText id="name" @bind-Value="Project.Name" class="form-control" />
                <ValidationMessage For="() => Project.Name" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="description" class="form-label">Описание:</label>
                <InputTextArea id="description" @bind-Value="Project.Description" @bind-Value:after="() => SetNullIfWhitespace(nameof(Project.Description))" class="form-control" />
                <ValidationMessage For="() => Project.Description" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="startdate" class="form-label">Дата начала*:</label>
                <InputDate id="startdate" @bind-Value="Project.StartDate" class="form-control" />
                <ValidationMessage For="() => Project.StartDate" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="isenddateenabled" class="form-label">Дата окончания:</label>
                <InputCheckbox id="isenddateenabled" @bind-Value="isEndDateEnabled" @bind-Value:after="() => OnEndDateChange()"></InputCheckbox>
            </div>
            @if (isEndDateEnabled)
            {
                <div class="mb-3">
                    <label for="enddate" class="form-label">Дата окончания:</label>
                    <InputDate id="enddate" @bind-Value="Project.EndDate" class="form-control" />
                    <ValidationMessage For="() => Project.EndDate" class="text-danger" />
                </div>
            }
            <div class="mb-3">
                <label for="gitlaburl" class="form-label">URL GitLab:</label>
                <InputText id="gitlaburl" @bind-Value="Project.GitlabUrl" @bind-Value:after="() => SetNullIfWhitespace(nameof(Project.GitlabUrl))" class="form-control" />
                <ValidationMessage For="() => Project.GitlabUrl" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="projectmanagerid" class="form-label">Руководитель проекта*:</label>
                <InputSelect id="projectmanagerid" @bind-Value="Project.ProjectManagerId" class="form-control">
                    <option value="">Выберите руководителя</option>
                    @foreach (var projectManager in ProjectManagers)
                    {
                        if (projectManager.IsDataFullfilled)
                        {
                            <option value="@projectManager.Id">@projectManager.Fullname</option>
                        }
                    }
                </InputSelect>
            </div>
            <button type="submit" class="btn btn-primary">Создать</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/projects">Назад к списку</a>
</div>

@code {
    ApplicationUser? currentUser;

    [SupplyParameterFromForm]
    private Project Project { get; set; } = new();

    private List<ApplicationUser> ProjectManagers = new();
    private bool isEndDateEnabled = false;

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        ProjectManagers = UserManager.Users.Where(u => u.Role == RoleConstants.ProjectManager).ToList();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated ?? false)
        {
            var userId = UserManager.GetUserId(user);
            currentUser = await UserManager.FindByIdAsync(userId!);
        }

        Project.StartDate = DateTime.Now;
        Project.EndDate = null;
    }

    private async System.Threading.Tasks.Task AddProject()
    {
        if (!isEndDateEnabled)
        {
            Project.EndDate = null;
        }

        ApplicationUser projectManager = (await UserManager.Users.FirstOrDefaultAsync(u => u.Id == Project.ProjectManagerId))!;

        using var context = DbFactory.CreateDbContext();
        Project.ProjectManager = projectManager;
        context.Attach(projectManager);
        context.Entry(projectManager).State = EntityState.Unchanged;

        Project.Participants = new List<ApplicationUser>(new[] { projectManager });

        context.Projects.Add(Project);
        await context.SaveChangesAsync();

        if (!string.IsNullOrEmpty(Project.GitlabUrl))
        {
            await GitlabService.InitializeGitlabConnection(Project.Id, currentUser!.PersonalAccessToken!);
        }
        NavigationManager.NavigateTo("/projects");
    }

    private void OnEndDateChange()
    {
        if (isEndDateEnabled)
        {
            Project.EndDate = DateTime.Now.AddMonths(1);
        }
    }

    private void SetNullIfWhitespace(string propertyName)
    {
        var value = typeof(Project).GetProperty(propertyName)!.GetValue(Project);
        var stringValue = value?.ToString();
        if (string.IsNullOrWhiteSpace(stringValue))
        {
            typeof(Project).GetProperty(propertyName)?.SetValue(Project, null);
        }
        else
        {
            typeof(Project).GetProperty(propertyName)?.SetValue(Project, stringValue);
        }
    }
}
