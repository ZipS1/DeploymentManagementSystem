@page "/projects/delete"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using DeploymentManagementSystem.Data.Models

@attribute [Authorize(Roles = "Admin,ProjectManager")]
@inject IDbContextFactory<DeploymentManagementSystem.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удалить</PageTitle>

<h1>Удалить</h1>

<p>Вы уверены, что хотите удалить это?</p>
<div>
    <h2>Проект</h2>
    <hr />
    @if (project is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Название</dt>
            <dd class="col-sm-10">@project.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Описание</dt>
            <dd class="col-sm-10">@project.Description</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Дата начала</dt>
            <dd class="col-sm-10">@project.StartDate</dd>
        </dl>
        <EditForm method="post" Model="project" OnValidSubmit="DeleteProject" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(project is null)">Удалить</button> |
            <a href="/projects">Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private Project? project;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        project = await context.Projects.FirstOrDefaultAsync(m => m.Id == Id);

        if (project is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async System.Threading.Tasks.Task DeleteProject()
    {
        using var context = DbFactory.CreateDbContext();
        context.Projects.Remove(project!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/projects");
    }
}
