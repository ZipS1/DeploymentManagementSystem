@page "/AddUserToProject"
@rendermode InteractiveServer

@using DeploymentManagementSystem.Data
@using DeploymentManagementSystem.Data.DomainStringConstants
@using DeploymentManagementSystem.Extensions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@attribute [Authorize(Roles = "Admin,ProjectManager")]
@inject UserManager<ApplicationUser> UserManager
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<h3>Добавить пользователя в проект</h3>

<h3>Список пользователей</h3>

@if (Users == null)
{
    <p>Загрузка...</p>
}
else if (Users.Count == 0)
{
    <p>Пользователи не найдены.</p>
}
else
{
    <table border="1">
        <thead>
            <tr>
                <th>Электронная почта</th>
                <th>Фамилия</th>
                <th>Имя</th>
                <th>Отчество</th>
                <th>Роль</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Users)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@user.Lastname</td>
                    <td>@user.Name</td>
                    <td>@user.Patronymic</td>
                    <td>@user.GetRoleTranslation()</td>
                    @if (Participants.Any(p => p.Id == user.Id))
                    {
                        <td><button class="btn btn-primary" disabled>Уже в проекте</button></td>
                    }
                    else
                    {
                        <td><button class="btn btn-primary" @onclick="() => OnAddToProjectButtonClick(user)">Добавить в проект</button></td>
                    }
                </tr>
            }
        </tbody>
    </table>

    <a href="@($"/projects/details?id={Id}")">Назад к проекту</a>
}

@code {
    private List<ApplicationUser> Users = new();
    private List<ApplicationUser> Participants = new();

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Users = UserManager.Users
                                .Where(u => u.Role != RoleConstants.Admin && u.Role != RoleConstants.NewUser)
                                .OrderByDescending(u => u.Role)
                                .ThenBy(u => u.Lastname)
                                .ThenBy(u => u.Name)
                                .ThenBy(u => u.Patronymic)
                                .ToList();

        Participants = context.Projects
                                    .Include(p => p.Participants)
                                    .FirstOrDefault(p => p.Id == Id)!.Participants!
                                    .ToList();
    }

    private void OnAddToProjectButtonClick(ApplicationUser user)
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(user);
        context.Projects.Include(p => p.Participants).FirstOrDefault(p => p.Id == Id)!.Participants!.Add(user);
        context.SaveChanges();
        Participants.Add(user);
        StateHasChanged();
    }
}
