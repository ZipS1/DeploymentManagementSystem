@page "/MyProjects"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using DeploymentManagementSystem.Data.Models
@using DeploymentManagementSystem.Data

@attribute [Authorize(Roles = "Developer,Lead")]
@implements IAsyncDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Мои проекты</PageTitle>

<h1>Мои проекты</h1>

@if (!isLoadingFinished)
{
    <p>Загрузка...</p>
}
else if (!isProjectsExist)
{
    <p>Вы пока не добавлены ни в один проект</p>
}
else
{
    <QuickGrid Class="table" Items="context.Projects
                                .Include(p => p.ProjectManager)
                                .Include(p => p.Participants)
                                .Where(p => p.Participants!.Any(u => u.Id == currentUserId))">
        <TemplateColumn Context="project" Title="Название">
            <a href="@($"projects/details?id={project.Id}")">@project.Name</a>
        </TemplateColumn>
        <TemplateColumn Context="project" Title="Описание">
            @(!string.IsNullOrEmpty(project.Description)
                ? project.Description
                : "-")
        </TemplateColumn>
        <TemplateColumn Context="project" Title="Дата начала">
            @project.StartDate.ToShortDateString()
        </TemplateColumn>
        <TemplateColumn Context="project" Title="Дата окончания">
            @(project.EndDate is not null
                ? project.EndDate.Value.ToShortDateString()
                : "-")
        </TemplateColumn>
        <TemplateColumn Context="project" Title="URL GitLab">
            @(!string.IsNullOrEmpty(project.GitlabUrl)
                ? project.GitlabUrl
                : "-")
        </TemplateColumn>
        <TemplateColumn Context="project" Title="Руководитель проекта">
            @project.ProjectManager?.Fullname
        </TemplateColumn>
    </QuickGrid>
}

@code {
    private ApplicationDbContext context = default!;
    private string? currentUserId;
    private bool isProjectsExist = false;
    bool isLoadingFinished = false;

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        }

        var items = context.Projects
                                .Include(p => p.Participants)
                                .Where(p => p.Participants!.Any(u => u.Id == currentUserId));

        if (await items.AnyAsync())
        {
            isProjectsExist = true;
        }

        isLoadingFinished = true;
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
