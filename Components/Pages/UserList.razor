@page "/Users"
@using DeploymentManagementSystem.Components.Account
@using DeploymentManagementSystem.Data
@using DeploymentManagementSystem.Data.DomainStringConstants
@using DeploymentManagementSystem.Extensions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@attribute [Authorize(Roles = "Admin,ProjectManager")]
@rendermode InteractiveServer

@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<h3>Список пользователей</h3>

@if (Users == null)
{
    <p>Загрузка...</p>
}
else if (Users.Count == 0)
{
    <p>Пользователи не найдены.</p>
}
else
{
    <table border="1">
        <thead>
            <tr>
                <th>Электронная почта</th>
                <th>Фамилия</th>
                <th>Имя</th>
                <th>Отчество</th>
                <th>Роль</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Users)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@(!string.IsNullOrEmpty(user.Lastname) ? user.Lastname : "-")</td>
                    <td>@(!string.IsNullOrEmpty(user.Name) ? user.Name : "-")</td>
                    <td>@(!string.IsNullOrEmpty(user.Patronymic) ? user.Patronymic : "-")</td>
                    <td>
                        @if (user.Id == currentUserId)
                        {
                            <InputSelect @bind-Value="user.Role" @bind-Value:after="() => OnRoleChange(user)" disabled="true">
                                @foreach (var role in Roles)
                                {
                                    <option value="@role.Name">@role.GetTranslation()</option>
                                }
                            </InputSelect>
                        }
                        else
                        {
                            <InputSelect @bind-Value="user.Role" @bind-Value:after="() => OnRoleChange(user)">
                                @foreach (var role in Roles)
                                {
                                    <option value="@role.Name">@role.GetTranslation()</option>
                                }
                            </InputSelect>
                        }
                    </td>

                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ApplicationUser> Users = new();
    private List<IdentityRole> Roles = new();
    private string? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        Users = UserManager.Users
                                .Where(u => u.Name != "root")
                                .OrderByDescending(u => u.Role)
                                .ThenBy(u => u.Lastname)
                                .ThenBy(u => u.Name)
                                .ThenBy(u => u.Patronymic)
                                .ToList();
        Roles = RoleManager.Roles.Where(r => r.Name != RoleConstants.Gitlab).ToList();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        }
    }

    private async Task OnRoleChange(ApplicationUser user)
    {
        var updateResult = await UserManager.UpdateAsync(user);
        await UserManager.RemoveFromRolesAsync(user, (await UserManager.GetRolesAsync(user)));
        await UserManager.AddToRoleAsync(user, user.Role);
    }
}
