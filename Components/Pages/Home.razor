@page "/"
@using DeploymentManagementSystem.Components.Account
@using DeploymentManagementSystem.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@attribute [Authorize]
@inject IdentityUserAccessor UserAccessor

<PageTitle>Home</PageTitle>

@if (!isLoadingFinished) {
	<p>Loading...</p>
} else if (!user.IsDataFullfilled) {
	<p>Please fullfill your <a href="Account/Manage">profile</a> first</p>
} else {
	<p>@greeting, @user.Lastname @user.Name @user.Patronymic</p>
}

<AuthorizeView Roles="NewUser">
	<p>You are a new user, ask project manager to give you a role in system</p>
</AuthorizeView>
<AuthorizeView Roles="Admin">
	<p>You are a superadmin</p>
</AuthorizeView>
<AuthorizeView Roles="ProjectManager">
	<p>You are a project manager</p>
</AuthorizeView>
<AuthorizeView Roles="Lead">
	<p>You are a lead developer</p>
</AuthorizeView>
<AuthorizeView Roles="Developer">
	<p>You are a developer</p>
</AuthorizeView>

@code {
	private ApplicationUser user = default!;
	private bool isLoadingFinished = false;
	private string? greeting;

	[CascadingParameter]
	private HttpContext HttpContext { get; set; } = default!;

	protected override async Task OnInitializedAsync()
	{
		int hour = DateTime.Now.Hour;
		if (hour >= 23 || hour <= 3)
		{
			greeting = "Good night";
		}
		else if (3 < hour && hour < 11)
		{
			greeting = "Good morning";
		}
		else if (11 <= hour && hour < 17)
		{
			greeting = "Good day";
		}
		else
		{
			greeting = "Good evening";
		}

		user = await UserAccessor.GetRequiredUserAsync(HttpContext);
		isLoadingFinished = true;
	}
}