@page "/"
@using DeploymentManagementSystem.Components.Account
@using DeploymentManagementSystem.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@attribute [Authorize]
@inject IdentityUserAccessor UserAccessor

<PageTitle>Главная</PageTitle>

@if (!isLoadingFinished)
{
	<p>Загрузка...</p>
}
else if (!user.IsDataFullfilled)
{
	<p>Пожалуйста, заполните ваш <a href="Account/Manage">профиль</a> вначале</p>
}
else
{
	<p>@greeting, @user.Lastname @user.Name @user.Patronymic</p>
}

<AuthorizeView Roles="NewUser">
	<p>Вы новый пользователь, обратитесь к руководителю проекта, чтобы получить роль в системе</p>
</AuthorizeView>
<AuthorizeView Roles="Admin">
	<p>Вы супер-администратор</p>
</AuthorizeView>
<AuthorizeView Roles="ProjectManager">
	<p>Вы руководитель проекта</p>
</AuthorizeView>
<AuthorizeView Roles="Lead">
	<p>Вы ведущий разработчик</p>
</AuthorizeView>
<AuthorizeView Roles="Developer">
	<p>Вы разработчик</p>
</AuthorizeView>

@code {
	private ApplicationUser user = default!;
	private bool isLoadingFinished = false;
	private string? greeting;

	[CascadingParameter]
	private HttpContext HttpContext { get; set; } = default!;

	protected override async Task OnInitializedAsync()
	{
		int hour = DateTime.Now.Hour;
		if (hour >= 23 || hour <= 3)
		{
			greeting = "Доброй ночи";
		}
		else if (3 < hour && hour < 11)
		{
			greeting = "Доброе утро";
		}
		else if (11 <= hour && hour < 17)
		{
			greeting = "Добрый день";
		}
		else
		{
			greeting = "Добрый вечер";
		}

		user = await UserAccessor.GetRequiredUserAsync(HttpContext);
		isLoadingFinished = true;
	}
}
