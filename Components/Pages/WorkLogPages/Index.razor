@page "/worklogs"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using DeploymentManagementSystem.Data.Models
@using DeploymentManagementSystem.Data

@attribute [Authorize(Roles = "Lead,Developer")]
@implements IAsyncDisposable
@inject IDbContextFactory<DeploymentManagementSystem.Data.ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>My worklogs</PageTitle>

<h1>My worklogs</h1>

@if (!IsLoadingFinished)
{
    <h4>Loading...</h4>
}
else
{
    <p>
        <a href=@($"worklogs/create?userid={currentUser!.Id}")>Create New</a>
    </p>

    <QuickGrid Class="table" Items="context.WorkLogs
                                                .Include(w => w.Task)
                                                .Where(w => w.UserId == currentUser.Id)">
        <TemplateColumn Context="worklog" Title="Date">
            @worklog.Date.ToShortDateString()
        </TemplateColumn>
        <PropertyColumn Property="worklog => worklog.TimeSpent" />
        <TemplateColumn Context="worklog" Title="Task">
            @worklog.Task!.Name
        </TemplateColumn>

        <TemplateColumn Context="worklog">
            <a href="@($"worklogs/edit?id={worklog.Id}&userid={currentUser.Id}")">Edit</a> |
            <a href="@($"worklogs/delete?id={worklog.Id}&userid={currentUser.Id}")">Delete</a>
        </TemplateColumn>
    </QuickGrid>
}

@code {
    private ApplicationDbContext context = default!;
    private ApplicationUser? currentUser;
    private bool IsLoadingFinished = false;

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = await UserManager.FindByIdAsync(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);

        context = DbFactory.CreateDbContext();

        IsLoadingFinished = true;
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
