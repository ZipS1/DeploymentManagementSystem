@page "/worklogs/delete"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using DeploymentManagementSystem.Data.Models

@attribute [Authorize(Roles = "Lead,Developer")]
@inject IDbContextFactory<DeploymentManagementSystem.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>WorkLog</h2>
    <hr />
    @if (worklog is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Date</dt>
            <dd class="col-sm-10">@worklog.Date</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">TimeSpent</dt>
            <dd class="col-sm-10">@worklog.TimeSpent</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">TaskId</dt>
            <dd class="col-sm-10">@worklog.TaskId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UserId</dt>
            <dd class="col-sm-10">@worklog.UserId</dd>
        </dl>
        <EditForm method="post" Model="worklog" OnValidSubmit="DeleteWorkLog" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(worklog is null)">Delete</button> |
            <a href="/worklogs">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private WorkLog? worklog;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        worklog = await context.WorkLogs.FirstOrDefaultAsync(m => m.Id == Id);

        if (worklog is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async System.Threading.Tasks.Task DeleteWorkLog()
    {
        using var context = DbFactory.CreateDbContext();
        context.WorkLogs.Remove(worklog!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/worklogs");
    }
}
