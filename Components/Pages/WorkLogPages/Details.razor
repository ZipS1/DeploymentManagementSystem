@page "/worklogs/details"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using DeploymentManagementSystem.Data.Models

@attribute [Authorize(Roles = "ProjectManager,Lead,Developer")]
@inject IDbContextFactory<DeploymentManagementSystem.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Детали</PageTitle>

<h1>Детали</h1>

<div>
    <h2>Трудозатраты</h2>
    <hr />
    @if (worklog is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Дата</dt>
            <dd class="col-sm-10">@worklog.Date</dd>
            <dt class="col-sm-2">Потраченное время</dt>
            <dd class="col-sm-10">@worklog.TimeSpent</dd>
            <dt class="col-sm-2">ID задачи</dt>
            <dd class="col-sm-10">@worklog.TaskId</dd>
            <dt class="col-sm-2">ID пользователя</dt>
            <dd class="col-sm-10">@worklog.UserId</dd>
        </dl>
        <div>
            <a href="@($"/worklogs/edit?id={worklog.Id}")">Редактировать</a> |
            <a href="@($"/worklogs")">Назад к списку</a>
        </div>
    }
</div>

@code {
    private WorkLog? worklog;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        worklog = await context.WorkLogs.FirstOrDefaultAsync(m => m.Id == Id);

        if (worklog is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
