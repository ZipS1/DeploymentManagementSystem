@page "/MyTasks"
@using DeploymentManagementSystem.Data
@using DeploymentManagementSystem.Data.DomainStringConstants
@using DeploymentManagementSystem.Extensions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject ILogger<MyTasks> _logger
@rendermode InteractiveServer

@attribute [Authorize(Roles = "Developer,Lead,ProjectManager")]

<PageTitle>Мои задачи</PageTitle>
<h3>Мои задачи</h3>

@if (!isLoadingCompleted)
{
    <h1>"Загрузка задач..."</h1>
}
else if (!isTasksExist)
{
    <p>У вас нет назначенных задач</p>
}
else
{
    <h1>Созданные задачи</h1>
    <QuickGrid Class="table" Items="@Tasks!.Where(c => c.CreatorUserId == currentUser!.Id && c.AssignedUserId != currentUser!.Id).AsQueryable()">
        <PropertyColumn Property="task => task.Name" Title="Название" />
        <PropertyColumn Property="task => task.Project!.Name" Title="Проект" />
        <TemplateColumn Context="task" Title="Описание">
            @(!string.IsNullOrEmpty(task.Description)
                ? task.Description
                : "-")
        </TemplateColumn>
        <TemplateColumn Context="task" Title="Срок выполнения">
            @(task.DueDate is not null
                ? task.DueDate.Value.ToShortDateString()
                : "-")
        </TemplateColumn>
        <TemplateColumn Context="task" Title="Статус">
            <InputSelect @bind-Value=task.TaskStatusId class="form-control" @bind-Value:after="() => OnTaskChange(task)">
            @{
                    var allowedStatusIds = FetchAllowedStatusIds(task, currentUser!);
                }
                @foreach (var status in TaskStatuses)
                {
                    @if (allowedStatusIds.Any(t => t == status.Id))
                    {
                        <option value="@status.Id">@status.GetTranslation()</option>
                    }
                }
            </InputSelect>
            @if (task.TaskStatus!.Name == TaskStatusConstants.InProgress && currentUser!.Id == task.AssignedUserId)
            {
                <a class="btn-sm btn-primary" href=@($"worklogs/create?userid={currentUser!.Id}&taskid={task.Id}")>Добавить</a>
            }
        </TemplateColumn>
        <PropertyColumn Property="task => task.TaskType!.GetTranslation()" Title="Тип" />
        <TemplateColumn Context="task" Title="Назначено">
            @(task.AssignedUserId is not null
                ? task.AssignedUser!.Fullname
                : "-")
        </TemplateColumn>
        <TemplateColumn Context="task">
            <HeaderTemplate>
                <div class="table-small-header">Дата создания</div>
            </HeaderTemplate>
            <ChildContent>
                @task.CreationDate.ToShortDateString()
            </ChildContent>
        </TemplateColumn>
        <PropertyColumn Property="task => task.CreatorUser!.Fullname">
            <HeaderTemplate>
                <div class="table-small-header">Создано пользователем</div>
            </HeaderTemplate>
        </PropertyColumn>
    </QuickGrid>

    <h1>Назначенные задачи</h1>
<QuickGrid Class="table" Items="@Tasks!.Where(c => c.AssignedUserId == currentUser!.Id).AsQueryable()">
    <PropertyColumn Property="task => task.Name" Title="Название" />
    <PropertyColumn Property="task => task.Project!.Name" Title="Проект" />
    <TemplateColumn Context="task" Title="Описание">
        @(!string.IsNullOrEmpty(task.Description)
                ? task.Description
                : "-")
                  </TemplateColumn>
                  <TemplateColumn Context="task" Title="Срок выполнения">
        @(task.DueDate is not null
                ? task.DueDate.Value.ToShortDateString()
                : "-")
    </TemplateColumn>
    <TemplateColumn Context="task" Title="Статус">
        <InputSelect @bind-Value=task.TaskStatusId class="form-control" @bind-Value:after="() => OnTaskChange(task)">
            @foreach (var status in TaskStatuses)
                {
                    var allowedStatusIds = FetchAllowedStatusIds(task, currentUser!);
                    @if (allowedStatusIds.Any(t => t == status.Id))
                    {
                        <option value="@status.Id">@status.GetTranslation()</option>
                    }
                }
            </InputSelect>
            @if (task.TaskStatus!.Name == TaskStatusConstants.InProgress)
            {
                <a class="btn-sm btn-primary" href=@($"worklogs/create?userid={currentUser!.Id}&taskid={task.Id}")>Добавить</a>
            }
    </TemplateColumn>
    <PropertyColumn Property="task => task.TaskType!.GetTranslation()" Title="Тип" />
    <TemplateColumn Context="task" Title="Назначено">
        @(task.AssignedUserId is not null
                ? task.AssignedUser!.Fullname
                : "-")
    </TemplateColumn>
    <TemplateColumn Context="task">
        <HeaderTemplate>
            <div class="table-small-header">Дата создания</div>
        </HeaderTemplate>
        <ChildContent>
            @task.CreationDate.ToShortDateString()
        </ChildContent>
    </TemplateColumn>
    <PropertyColumn Property="task => task.CreatorUser!.Fullname">
        <HeaderTemplate>
            <div class="table-small-header">Создано пользователем</div>
        </HeaderTemplate>
    </PropertyColumn>
</QuickGrid>
}

@code {
    private ApplicationDbContext context = default!;
    private ApplicationUser? currentUser;
    private bool isLoadingCompleted = false;
    private bool isTasksExist = false;

    private List<Data.Models.Task>? Tasks { get; set; }
    private List<Data.Models.TaskStatus> TaskStatuses { get; set; } = new();

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = await UserManager.FindByIdAsync(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);

        context = DbFactory.CreateDbContext();
        TaskStatuses = await context.TaskStatuses.ToListAsync();

        Tasks = context.Tasks
            .Include(t => t.Project)
            .Include(t => t.TaskType)
            .Include(t => t.TaskStatus)
            .Include(a => a.AssignedUser)
            .Include(c => c.CreatorUser)
            .Where(c => c.CreatorUserId == currentUser!.Id || c.AssignedUserId == currentUser.Id)
            .OrderBy(t => t.CreationDate).ToList();

        if (Tasks.Any())
        {
            isTasksExist = true;
        }

        isLoadingCompleted = true;
    }

    private List<int> FetchAllowedStatusIds(Data.Models.Task task, ApplicationUser user)
    {
        List<int> allowedStatusIds = new(new int[] { task.TaskStatusId });
        using var context = DbFactory.CreateDbContext();
        allowedStatusIds.AddRange(context.TaskStatusTransitions
            .Where(t => t.TaskTypeId == task.TaskTypeId)
            .Where(t => task.TaskStatusId == t.FromTaskStatusId)
            .Where(t => (t.AllowedRoles.Contains(RoleConstants.Assignee) && user.Id == task.AssignedUserId) ||
                        t.AllowedRoles.Contains(user.Role))
            .Select(t => t.ToTaskStatusId));

        var stringedStatusIds = string.Join(',', allowedStatusIds);
        _logger.LogInformation($"Allowed status IDs for task.Id{task.Id}: {stringedStatusIds}");
        return allowedStatusIds;
    }

    private void OnTaskChange(Data.Models.Task task)
    {
        if (task.TaskStatus!.Name == TaskStatusConstants.New && task.AssignedUserId is not null)
        {
            task.TaskStatusId = TaskStatuses.FirstOrDefault(t => t.Name == TaskStatusConstants.Assigned)!.Id;
        }

        using var context = DbFactory.CreateDbContext();
        var existingTask = context.Tasks.Find(task.Id)!;

        context.Entry(existingTask).CurrentValues.SetValues(task);
        context.SaveChanges();
        NavigationManager.Refresh(forceReload: true);
    }
}
