@page "/tasks/delete"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using DeploymentManagementSystem.Data.Models

@attribute [Authorize(Roles = "Admin,ProjectManager,Lead")]
@inject IDbContextFactory<DeploymentManagementSystem.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удалить</PageTitle>

<h1>Удалить</h1>

<p>Вы уверены, что хотите удалить это?</p>
<div>
    <h2>Задача</h2>
    <hr />
    @if (task is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Название</dt>
            <dd class="col-sm-10">@task.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Описание</dt>
            <dd class="col-sm-10">@task.Description</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Дата создания</dt>
            <dd class="col-sm-10">@task.CreationDate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Срок выполнения</dt>
            <dd class="col-sm-10">@task.DueDate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ID статуса задачи</dt>
            <dd class="col-sm-10">@task.TaskStatusId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ID типа задачи</dt>
            <dd class="col-sm-10">@task.TaskTypeId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ID проекта</dt>
            <dd class="col-sm-10">@task.ProjectId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ID назначенного пользователя</dt>
            <dd class="col-sm-10">@task.AssignedUserId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ID создателя задачи</dt>
            <dd class="col-sm-10">@task.CreatorUserId</dd>
        </dl>
        <EditForm method="post" Model="task" OnValidSubmit="DeleteTask" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(task is null)">Удалить</button> |
            <a href=@($"/tasks?projectid={ProjectId}")>Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private Data.Models.Task? task;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromQuery]
    private int ProjectId { get; set; }

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        task = await context.Tasks.FirstOrDefaultAsync(m => m.Id == Id);

        if (task is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async System.Threading.Tasks.Task DeleteTask()
    {
        using var context = DbFactory.CreateDbContext();
        context.Tasks.Remove(task!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo($"/tasks?projectid={ProjectId}");
    }
}
