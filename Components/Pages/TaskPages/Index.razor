@page "/tasks"
@using DeploymentManagementSystem.Extensions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using DeploymentManagementSystem.Data.Models
@using DeploymentManagementSystem.Data

@attribute [Authorize(Roles = "Admin,ProjectManager,Lead,Developer")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

@if (!isLoadingCompleted)
{
    <PageTitle>"Загрузка задач..."</PageTitle>
    <h1>"Загрузка задач..."</h1>
}
else
{
    <PageTitle>@($"\"{projectName}\" задачи") </PageTitle>
    <h1>@($"\"{projectName}\" задачи")</h1>
    <p>Общее время трудозатрат: @(FetchWorklogsForProject()) ч</p>

    <a href=@($"projects/details?id={ProjectId}")>Назад к проекту</a>
    <AuthorizeView Roles="Admin,ProjectManager,Lead">
        <p>
            <a href=@($"tasks/create?projectid={ProjectId}")>Создать новую задачу</a>
        </p>
    </AuthorizeView>

    <QuickGrid Class="table" Items="context.Tasks
                                                .Include(t => t.TaskType)
                                                .Include(t => t.TaskStatus)
                                                .Include(a => a.AssignedUser)
                                                .Include(c => c.CreatorUser)
                                                .Where(t => t.ProjectId == ProjectId)
                                                .OrderBy(t => t.CreationDate)">
        <PropertyColumn Property="task => task.Name" Title="Название" />
        <TemplateColumn Context="task">
            <HeaderTemplate>
                <div class="table-small-header">Описание</div>
            </HeaderTemplate>
            <ChildContent>
                @(!string.IsNullOrEmpty(task.Description)
                    ? task.Description
                    : "-")
            </ChildContent>
        </TemplateColumn>
        <TemplateColumn Context="task">
            <HeaderTemplate>
                <div class="table-small-header">Срок<br/>выполнения</div>
            </HeaderTemplate>
            <ChildContent>
                @(task.DueDate is not null
                    ? task.DueDate.Value.ToShortDateString()
                    : "-")
            </ChildContent>
        </TemplateColumn>
        <TemplateColumn Context="task" Title="Статус">
            <InputSelect @bind-Value=task.TaskStatusId class="form-control" @bind-Value:after="() => OnTaskChange(task)">
                @foreach (var status in TaskStatuses)
                {
                    var allowedStatusIds = FetchAllowedStatusIds(task, currentUser!);
                    @if (allowedStatusIds.Any(t => t == status.Id))
                    {
                        <option value="@status.Id">@status.GetTranslation()</option>
                    }
                }
            </InputSelect>
        </TemplateColumn>
        <PropertyColumn Property="task => task.TaskType!.GetTranslation()" Title="Тип" />
        <TemplateColumn Context="task" Title="Назначено">
            <AuthorizeView Roles="Developer">
                @(task.AssignedUserId is not null
                    ? task.AssignedUser!.Fullname
                    : "-")
            </AuthorizeView>
            <AuthorizeView Roles="Admin,ProjectManager,Lead">
                @if (task.AssignedUserId is null)
                {
                    <button class="btn btn-primary" @onclick="() => OnAssignToTaskClick(task)">Добавить исполнителя</button>
                }
                else
                {
                    <div class="d-inline-flex">
                        <InputSelect @bind-Value="task.AssignedUserId" class="form-control" @bind-Value:after="() => OnTaskChange(task)">
                            @foreach (var participant in Participants)
                            {
                                if (participant.IsDataFullfilled)
                                {
                                    <option value="@participant.Id">@participant.Fullname</option>
                                }
                            }
                        </InputSelect>
                        <button class="btn-sm btn-danger" @onclick="() => OnRemoveAsigneeClick(task)">-</button>
                    </div>
                }
            </AuthorizeView>
        </TemplateColumn>
        <TemplateColumn Context="task">
            <HeaderTemplate>
                <div class="table-small-header">Трудозатраты</div>
            </HeaderTemplate>
            <ChildContent>
                @FetchWorklogsForTask(task)
            </ChildContent>
        </TemplateColumn>
        <TemplateColumn Context="task">
            <HeaderTemplate>
                <div class="table-small-header">Дата создания</div>
            </HeaderTemplate>
            <ChildContent>
                @task.CreationDate.ToShortDateString()
            </ChildContent>
        </TemplateColumn>
        <PropertyColumn Property="task => task.CreatorUser!.Fullname">
            <HeaderTemplate>
                <div class="table-small-header">Создано пользователем</div>
            </HeaderTemplate>
        </PropertyColumn>

        <TemplateColumn Context="task">
            <AuthorizeView Roles="Admin,ProjectManager,Lead">
                <a href="@($"tasks/edit?id={task.Id}&projectid={ProjectId}")">Редактировать</a> |
                <a href="@($"tasks/delete?id={task.Id}&projectid={ProjectId}")">Удалить</a>
            </AuthorizeView>
        </TemplateColumn>
    </QuickGrid>
}

@code {
    private ApplicationDbContext context = default!;
    private ApplicationUser? currentUser;
    private List<ApplicationUser> Participants = new();

    private string? projectName;
    private bool isLoadingCompleted = false;

    private List<Data.Models.TaskStatus> TaskStatuses { get; set; } = new();

    [SupplyParameterFromQuery]
    private int ProjectId { get; set; }

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        var project = context.Projects
                                .Include(p => p.Participants)
                                .FirstOrDefault(p => p.Id == ProjectId)!;

        projectName = project.Name;
        Participants = project.Participants!.ToList();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = await UserManager.FindByIdAsync(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);

        TaskStatuses = await context.TaskStatuses.ToListAsync();
        isLoadingCompleted = true;
    }

    private List<int> FetchAllowedStatusIds(Data.Models.Task task, ApplicationUser user)
    {
        List<int> allowedStatusIds = new( new int[] { task.TaskStatusId });
        using var context = DbFactory.CreateDbContext();
        allowedStatusIds.AddRange(context.TaskStatusTransitions
            .Where(t => task.TaskStatusId == t.FromTaskStatusId)
            .Where(t => t.AllowedRoles.Contains("Assignee") && user.Id == task.AssignedUserId)
            .Select(t => t.ToTaskStatusId));

        allowedStatusIds.AddRange(context.TaskStatusTransitions
            .Where(t => task.TaskStatusId == t.FromTaskStatusId)
            .Where(t => t.AllowedRoles.Contains(user.Role))
            .Select(t => t.ToTaskStatusId));

        return allowedStatusIds;
    }

    private decimal FetchWorklogsForTask(Data.Models.Task task)
    {
        using var context = DbFactory.CreateDbContext();
        return context.WorkLogs.Where(w => w.TaskId == task.Id).Sum(w => w.TimeSpent);
    }

    private decimal FetchWorklogsForProject()
    {
        using var context = DbFactory.CreateDbContext();
        return context.WorkLogs.Include(w => w.Task).Where(w => w.Task!.ProjectId == ProjectId).Sum(w => w.TimeSpent);
    }

    private void OnTaskChange(Data.Models.Task task)
    {
        if (task.TaskStatus!.Name == "New" && task.AssignedUserId is not null)
        {
            task.TaskStatusId = TaskStatuses.FirstOrDefault(t => t.Name == "Assigned")!.Id;
        }

        using var context = DbFactory.CreateDbContext();
        var existingTask = context.Tasks.Find(task.Id)!;

        context.Entry(existingTask).CurrentValues.SetValues(task);
        context.SaveChanges();
        NavigationManager.Refresh(forceReload: true);
    }

    private void OnAssignToTaskClick(Data.Models.Task task)
    {
        using var context = DbFactory.CreateDbContext();
        var existingTask = context.Tasks.Find(task.Id)!;

        existingTask.AssignedUserId = currentUser!.Id;
        context.SaveChanges();
        NavigationManager.Refresh(forceReload: true);
    }

    private void OnRemoveAsigneeClick(Data.Models.Task task)
    {
        using var context = DbFactory.CreateDbContext();
        var existingTask = context.Tasks.Find(task.Id)!;

        existingTask.AssignedUserId = null;
        existingTask.TaskStatusId = TaskStatuses.FirstOrDefault(t => t.Name == "New")!.Id;
        context.SaveChanges();
        NavigationManager.Refresh(forceReload: true);
    }
}
