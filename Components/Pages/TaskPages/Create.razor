@page "/tasks/create"
@using DeploymentManagementSystem.Data
@using DeploymentManagementSystem.Data.DomainStringConstants
@using DeploymentManagementSystem.Extensions
@using DeploymentManagementSystem.Localization
@using DeploymentManagementSystem.Services
@using DeploymentManagementSystem.Services.DTOs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory

@attribute [Authorize(Roles = "Admin,ProjectManager,Lead")]
@inject ILogger<Create> _logger
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

@inject GitlabService GitlabService
@rendermode InteractiveServer

<PageTitle>Создать</PageTitle>

<h1>Создать</h1>

<h2>Задача</h2>
<hr />

@if (!isLoadingCompleted)
{
    <p>Загрузка...</p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Task" OnValidSubmit="AddTask" FormName="create" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="mb-3">
                    <label for="name" class="form-label">Название*:</label>
                    <InputText id="name" @bind-Value="Task.Name" class="form-control" @bind-Value:after="() => OnNameChange()" />
                    <ValidationMessage For="() => Task.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Описание:</label>
                    <InputTextArea id="description" @bind-Value="Task.Description" @bind-Value:after="() => SetNullIfWhitespace(nameof(Task.Description))" class="form-control" />
                    <ValidationMessage For="() => Task.Description" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="creationdate" class="form-label">Дата создания:</label>
                    <InputDate id="creationdate" @bind-Value="Task.CreationDate" class="form-control" disabled="True" />
                    <ValidationMessage For="() => Task.CreationDate" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="isduedateenabled" class="form-label">Срок выполнения:</label>
                    <InputCheckbox id="isduedateenabled" @bind-Value="isDueDateEnabled" @bind-Value:after="() => OnDueDateChange()"></InputCheckbox>
                </div>
                @if (isDueDateEnabled)
                {
                    <div class="mb-3">
                        <label for="duedate" class="form-label">Срок выполнения:</label>
                        <InputDate id="duedate" @bind-Value="Task.DueDate" class="form-control" />
                        <ValidationMessage For="() => Task.DueDate" class="text-danger" />
                    </div>
                }
                <div class="mb-3">
                    <InputNumber id="taskstatusid" @bind-Value="Task.TaskStatusId" class="form-control" hidden />
                    <ValidationMessage For="() => Task.TaskStatusId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="tasktypeid" class="form-label">Тип задачи*:</label>
                    <InputSelect id="tasktypeid" @bind-Value="Task.TaskTypeId" @bind-Value:after="() => OnTaskTypeChange()" class=" form-control">
                        <option value="">Выберите тип задачи</option>
                        @foreach (var taskType in TaskTypes)
                        {
                            <option value="@taskType.Id">@taskType.GetTranslation()</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Task.TaskTypeId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="ref_name" class="form-label">Имя ветки*:</label>
                    <InputText id="ref_name" @bind-Value="Task.RefName" class="form-control" disabled />
                    <ValidationMessage For="() => Task.RefName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <InputNumber id="projectid" @bind-Value="Task.ProjectId" class="form-control" hidden />
                    <ValidationMessage For="() => Task.ProjectId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="assigneduserid" class="form-label">Назначенный пользователь:</label>
                    <InputSelect id="assigneduserid" @bind-Value="Task.AssignedUserId" class="form-control">
                        <option value="">Нет</option>
                        @foreach (var participant in Participants)
                        {
                            if (participant.IsDataFullfilled)
                            {
                                <option value="@participant.Id">@participant.Fullname</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Task.AssignedUserId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <InputText id="creatoruserid" @bind-Value="Task.CreatorUserId" class="form-control" hidden />
                    <ValidationMessage For="() => Task.CreatorUserId" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Создать</button>
            </EditForm>
        </div>
    </div>

    <div>
        <a href=@($"tasks?projectid={ProjectId}")>Назад к списку</a>
    </div>
}

@code {
    private bool isLoadingCompleted = false;
    private ApplicationUser? currentUser;
    private List<ApplicationUser> Participants = new();
    private List<Data.Models.TaskType> TaskTypes = new();
    private bool isDueDateEnabled = false;
    private const int SLUG_LENGTH_MAX = 20;

    [SupplyParameterFromForm]
    private Data.Models.Task Task { get; set; } = new();

    [SupplyParameterFromQuery]
    private int ProjectId { get; set; }

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated ?? false)
        {
            var userId = UserManager.GetUserId(user);
            currentUser = await UserManager.FindByIdAsync(userId!);
        }

        using var context = DbFactory.CreateDbContext();

        Participants = context.Projects
                                .Include(p => p.Participants)
                                .FirstOrDefault(p => p.Id == ProjectId)!
                                .Participants!
                                .ToList();

        TaskTypes = context.TaskTypes
                                .ToList();

        Task.ProjectId = ProjectId;
        Task.CreationDate = DateTime.Now;
        Task.CreatorUserId = currentUser!.Id;

        Task.RefName = $"<type>/<name>-<id>";
        isLoadingCompleted = true;
    }

    private async System.Threading.Tasks.Task AddTask()
    {
        using var context = DbFactory.CreateDbContext();

        if (string.IsNullOrEmpty(Task.AssignedUserId))
        {
            Task.AssignedUserId = null;
            Task.TaskStatusId = (await context.TaskTypes.FirstOrDefaultAsync(t => t.Id == Task.TaskTypeId))!.InitialTaskStatusId;
        }
        else
        {
            Task.TaskStatusId = (await context.TaskStatuses.FirstOrDefaultAsync(s => s.Name == TaskStatusConstants.Assigned))!.Id;
        }

        if (!isDueDateEnabled)
        {
            Task.DueDate = null;
        }

        UpdateRefName();
        context.Tasks.Add(Task);
        await context.SaveChangesAsync();

        Task.RefName = Task.RefName!.Replace("<id>", Task.Id.ToString());
        await context.SaveChangesAsync();

        var project = await context.Projects.SingleOrDefaultAsync(p => p.Id == Task.ProjectId)!;
        var projectDTO = new GitlabProjectDTO 
        { 
            Url = project!.GitlabUrl,
            ProjectId = project!.GitlabProjectId!.Value,
            DefaultBranch = project.GitlabDefaultBranch 
        };

        try
        {
            await GitlabService.CreateBranchAndMRForTask(projectDTO, Task.RefName, currentUser!.PersonalAccessToken!);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to create task branch and MR for Task.Id={Task.Id}", Task.Id);            
        }
        finally
        {
            NavigationManager.NavigateTo($"/tasks?projectid={ProjectId}");
        }
    }

    private void SetNullIfWhitespace(string propertyName)
    {
        var value = typeof(Data.Models.Task).GetProperty(propertyName)!.GetValue(Task);
        var stringValue = value?.ToString();
        if (string.IsNullOrWhiteSpace(stringValue))
        {
            typeof(Data.Models.Task).GetProperty(propertyName)?.SetValue(Task, null);
        }
        else
        {
            typeof(Data.Models.Task).GetProperty(propertyName)?.SetValue(Task, stringValue);
        }
    }

    private void OnDueDateChange()
    {
        if (isDueDateEnabled)
        {
            Task.DueDate = DateTime.Now.AddDays(7);
        }
    }

    private void UpdateRefName()
    {
        var type = TaskTypes.FirstOrDefault(t => t.Id == Task.TaskTypeId);
        string nameSlug = ToSlug(Task.Name, SLUG_LENGTH_MAX);

        if (type is null)
        {
            Task.RefName = $"<type>/{nameSlug}-<id>";
        }
        else
        {
            Task.RefName = $"{type.Slug}/{nameSlug}-<id>";
        }
    }

    private void OnTaskTypeChange()
    {
        UpdateRefName();
    }

    private void OnNameChange()
    {
        UpdateRefName();
    }

    private string ToSlug(string input, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(input))
            return "<name>";

        string slug = CyrillicToLatinProvider.ToLatin(input);

        slug = System.Text.RegularExpressions.Regex.Replace(slug, @"[^a-z0-9]+", "-");
        slug = slug.Trim('-');
        if (slug.Length > maxLength)
            slug = slug.Substring(0, maxLength);

        slug = slug.TrimEnd('-');
        if (string.IsNullOrEmpty(slug))
            return "<name>";

        return slug;
    }
}
