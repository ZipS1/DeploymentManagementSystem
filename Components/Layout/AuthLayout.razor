@inherits LayoutComponentBase

<div class="page">
    <main>
        <div class="top-row px-4 d-flex align-items-center justify-content-between">
            <div class="logo-block d-flex align-items-center">
                <a href="">
                    <img src="icons/logo-full.png" alt="Логотип" style="height: 100px;" />
                </a>
            </div>
            <div class="flex-grow-1 text-center">
                <span class="navbar-brand text-dark text-decoration-none" style="font-size: 1.5rem;">
                    Система управления проектами
                </span>
            </div>
            <div style="min-width:120px;"></div>
        </div>

        <div class="content-wrapper">
            <article class="content w-25">
                @Body
            </article>
        </div>
    </main>
</div>

<div id="blazor-error-ui">
    Произошла непредвиденная ошибка.
    <a href="" class="reload">Перезагрузить</a>
    <a class="dismiss">🗙</a>
</div>
