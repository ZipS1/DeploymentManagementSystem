@page "/Account/Manage"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using DeploymentManagementSystem.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager

<PageTitle>Профиль</PageTitle>

<h3>Профиль</h3>
@if (user is not null)
{
    if (IsAccountFullfilled())
    {
        <p>Заполнено</p>
    }
    else
    {
        <p>Не заполнено</p>
    }
}
<StatusMessage />

<div class="row">
    <div class="col-md-6">
        <EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <div class="form-floating mb-3">
                <input type="text" value="@username" class="form-control" placeholder="Выберите ваше имя пользователя." disabled />
                <label for="username" class="form-label">Имя пользователя</label>
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.PhoneNumber" class="form-control" placeholder="Введите ваш номер телефона." hidden />
                <label for="phone-number" class="form-label">Номер телефона</label>
                <ValidationMessage For="() => Input.PhoneNumber" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Lastname" class="form-control" placeholder="Введите вашу фамилию." />
                <label for="lastname" class="form-label">Фамилия</label>
                <ValidationMessage For="() => Input.Lastname" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Name" class="form-control" placeholder="Введите ваше имя." />
                <label for="name" class="form-label">Имя</label>
                <ValidationMessage For="() => Input.Name" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Patronymic" class="form-control" placeholder="Введите ваше отчество." />
                <label for="patronymic" class="form-label">Отчество</label>
                <ValidationMessage For="() => Input.Patronymic" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.PersonalAccessToken" class="form-control" placeholder="Введите ваш PAT из Gitlab." type="password" />
                <label for="pat" class="form-label">Токен доступа</label>
                <ValidationMessage For="() => Input.PersonalAccessToken" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Сохранить</button>
        </EditForm>
    </div>
</div>

@code {
    private ApplicationUser user = default!;
    private string? username;
    private string? phoneNumber;
    private string? lastname;
    private string? name;
    private string? patronymic;
    private string? pat;

    private bool isDataChanged = false;

    private const string PhoneNumberPlaceholder = "+21231231212";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        username = await UserManager.GetUserNameAsync(user);
        phoneNumber = await UserManager.GetPhoneNumberAsync(user);
        lastname = user.Lastname;
        name = user.Name;
        patronymic = user.Patronymic;
        pat = user.PersonalAccessToken;

        Input.PhoneNumber ??= PhoneNumberPlaceholder;
        Input.Lastname ??= lastname;
        Input.Name ??= name;
        Input.Patronymic ??= patronymic;
        Input.PersonalAccessToken ??= pat;
    }

    private async Task OnValidSubmitAsync()
    {
        if (Input.PhoneNumber != phoneNumber)
        {
            var setPhoneResult = await UserManager.SetPhoneNumberAsync(user, Input.PhoneNumber);
            if (!setPhoneResult.Succeeded)
            {
                RedirectManager.RedirectToCurrentPageWithStatus("Ошибка: не удалось установить номер телефона.", HttpContext);
            }
        }

        if (Input.Lastname != lastname)
        {
            user.Lastname = Input.Lastname;
            isDataChanged = true;
        }

        if (Input.Name != name)
        {
            user.Name = Input.Name;
            isDataChanged = true;
        }

        if (Input.Patronymic != patronymic)
        {
            user.Patronymic = Input.Patronymic;
            isDataChanged = true;
        }

        if (Input.PersonalAccessToken != pat)
        {
            user.PersonalAccessToken = Input.PersonalAccessToken;
            isDataChanged = true;
        }

        if (isDataChanged)
        {
            if (IsAccountFullfilled())
            {
                user.IsDataFullfilled = true;
            }

            var setNameResult = await UserManager.UpdateAsync(user);
            if (!setNameResult.Succeeded)
            {
                RedirectManager.RedirectToCurrentPageWithStatus("Ошибка: не удалось установить новые данные.", HttpContext);
            }
        }

        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToCurrentPageWithStatus("Ваш профиль был обновлён", HttpContext);
    }

    private bool IsAccountFullfilled() => user.Lastname is not null && user.Name is not null && user.Patronymic is not null && user.PersonalAccessToken is not null;

    private sealed class InputModel
    {
        [Phone]
        [Display(Name = "Номер телефона")]
        public string? PhoneNumber { get; set; }

        [StringLength(99, ErrorMessage = "Длина должна быть меньше 100 символов")]
        public string? Lastname { get; set; }

        [RegularExpression("^(?!root$).*$", ErrorMessage = "Значение не может быть 'root'")]
        [StringLength(99, ErrorMessage = "Длина должна быть меньше 100 символов")]
        public string? Name { get; set; }

        [StringLength(99, ErrorMessage = "Длина должна быть меньше 100 символов")]
        public string? Patronymic { get; set; }

        [StringLength(99, ErrorMessage = "Длина должна быть меньше 100 символов")]
        public string? PersonalAccessToken { get; set; }
    }
}
